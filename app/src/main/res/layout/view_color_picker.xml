<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The swatch sits over a light/dark split so alpha is visible. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#000000" />
        </LinearLayout>

        <View
            android:id="@+id/picker_swatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="@string/red"
            android:textColor="@color/text_secondary" />

        <SeekBar
            android:id="@+id/picker_red"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255" />

        <TextView
            android:id="@+id/picker_red_value"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="@string/green"
            android:textColor="@color/text_secondary" />

        <SeekBar
            android:id="@+id/picker_green"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255" />

        <TextView
            android:id="@+id/picker_green_value"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="@string/blue"
            android:textColor="@color/text_secondary" />

        <SeekBar
            android:id="@+id/picker_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255" />

        <TextView
            android:id="@+id/picker_blue_value"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="@string/alpha"
            android:textColor="@color/text_secondary" />

        <SeekBar
            android:id="@+id/picker_alpha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255" />

        <TextView
            android:id="@+id/picker_alpha_value"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hex"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/picker_hex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:digits="#0123456789ABCDEFabcdef"
            android:fontFamily="monospace"
            android:inputType="textNoSuggestions"
            android:maxLength="9"
            android:singleLine="true"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</merge>
